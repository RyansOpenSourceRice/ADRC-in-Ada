--  SPDX-License-Identifier: Apache-2.0
--
--  SPARK-only proof project: sees the pure core in src/, never examples,
--  tests, or any boundary adapter. Run with:
--    gnatprove -P proof/spark_core.gpr -U --level=2

project Spark_Core is
   --  units/ holds proof-only instantiations that make gnatprove analyze
   --  the generic core units at a concrete capacity.
   for Source_Dirs use ("../src", "units");
   for Object_Dir use "obj";
end Spark_Core;
