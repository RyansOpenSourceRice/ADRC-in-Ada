## Decisions (DESIGN.md is generated from these)

onto:decision-linear-first a onto:Decision ;
    onto:name "Linear ADRC first, nonlinear staged" ;
    onto:rationale "The bandwidth-parameterized linear variant (Gao 2003) is the smallest complete ADRC; the bounded-arithmetic proof pattern had to be established on it before nonlinear terms (|e|^alpha, fhan) extend the skeleton." ;
    onto:alternative "Nonlinear ADRC from day one — rejected: nonlinear proof surface before the skeleton is proven inverts the staging." ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-core-linear .

onto:decision-nonlinear-siblings a onto:Decision ;
    onto:name "Nonlinear siblings over the same skeleton" ;
    onto:rationale "Fal, NL_TD, NL_ESO, NL_Control and NL_Controller reuse the linear units' contract vocabulary, saturation discipline, and one-call Step shape; fhan is proven interval-style with the output bound |fhan| <= r stated as a postcondition." ;
    onto:alternative "One generic controller with a linear/nonlinear switch — rejected: sibling surfaces keep configurations honest and proof obligations small." ;
    onto:date "2026-11-04"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-core-nonlinear .

onto:decision-trusted-numerics a onto:Decision ;
    onto:name "One trust boundary for fractional powers" ;
    onto:rationale "The elementary exponentiation behind fal sits outside the SPARK view and its overflow check is a documented proof limitation; a SPARK_Mode => Off wrapper (Frac_Power) with stated input and result-bound contracts keeps the assumption in one auditable place, and every use site saturates the result." ;
    onto:alternative "Waiving the overflow checks with review annotations — rejected: a stated assumption with a one-line body beats scattered waived checks." ;
    onto:date "2026-11-04"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-core-nonlinear .

onto:decision-generic-real a onto:Decision ;
    onto:name "Generic core over the real type" ;
    onto:rationale "Each unit is generic over type Real_Type is digits <> and instantiates the Limits contract vocabulary itself; the non-generic root carries shared constants. This keeps a fixed-point instantiation path open for no-FPU embedded targets." ;
    onto:alternative "Fixed Float — rejected: locks out the fixed-point direction; re-instantiation is the point of the generic formals." ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-core-linear .

onto:decision-bounded-arithmetic a onto:Decision ;
    onto:name "Saturate every intermediate term" ;
    onto:rationale "SPARK 16 discharges range and float-overflow checks; unbounded product chains stall the prover. Saturating each intermediate into the signal range makes every verification condition interval-trivial, and the bound is far outside the operating band (golden tests pin bit-identical trajectories within it)." ;
    onto:alternative "Assume statements bounding products — rejected: trust-in-author weakens the assurance story; exact discrete pole placement — deferred: larger constant surface for a first core." ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-core-linear .

onto:decision-fixed-band-arithmetic a onto:Decision ;
    onto:name "Fixed-point operand bands and reciprocal-only division" ;
    onto:rationale "GNAT bounds the universal_fixed intermediate of every fixed-point binary operation at about 2**Size * Delta real units, computed before any result clamp could run, so full-range operands can trap at runtime. The fixed siblings clamp operands into proven bands (Sum_Band 5e5, Product_Band 1e3) before the operation, clamp results by comparison on the exact intermediate, and replace the one needed quotient with a multiply by S_Recip (b0), whose divisor floor Min_Effectiveness (1e-3) keeps the reciprocal inside the intermediate." ;
    onto:alternative "Prefilter-then-convert on the raw intermediate — rejected: the intermediate itself overflows at contract extremes (verified by a refutable VC), so the clamp decision would raise Constraint_Error before it could clamp; general S_Div with a delta-floor precondition — rejected: provably trappy for wide dividends; trusting the runtime overflow check — rejected: fires where the floating-point family saturates." ;
    onto:date "2026-11-04"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-core-fixed .

onto:decision-last-u-causality a onto:Decision ;
    onto:name "Observer consumes the previous control value" ;
    onto:rationale "The LESO update uses State.Last_U instead of the value being computed now, breaking the algebraic loop between law and observer and matching sampled-controller behavior in front of a zero-order hold." ;
    onto:alternative "Same-step feedback — rejected: creates an algebraic loop and a non-sequential step semantics." ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-core-linear .

onto:decision-caller-state a onto:Decision ;
    onto:name "Caller-owned state records" ;
    onto:rationale "State lives in records the caller declares and passes; no hidden globals, no heap, no I/O — reentrant by construction and embeddable in a bare-metal task without further work." ;
    onto:alternative "Module-level state — rejected: not reentrant and unprovable data flow across steps." ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-core-linear .

onto:decision-apache-license a onto:Decision ;
    onto:name "Apache-2.0 license" ;
    onto:rationale "An embeddable control library maximizes downstream adoption under permissive terms; the license grant and notice conventions are recorded in LICENSE." ;
    onto:alternative "GPL-family licenses — rejected: link-time viral terms are the wrong default for a library meant to be embedded in third-party control applications." ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:status "active" .

onto:decision-github-home a onto:Decision ;
    onto:name "GitHub as the hosting forge" ;
    onto:rationale "The Ada/SPARK and Alire ecosystems are GitHub-native (crate discovery, CI actions); routing is per-project, not ideological (§26, §27)." ;
    onto:alternative "GitLab hosting — rejected for this repo: weaker discovery path for the Alire/GNAT audience." ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:status "active" .

onto:decision-single-gate a onto:Decision ;
    onto:name "Pre-commit is the single gate" ;
    onto:rationale "The checked-in pre-commit config is the only configuration for gitleaks, spellcheck, and linting; CI runs the same suite. Two configs for one tool guarantee drift (§9)." ;
    onto:alternative "Parallel CI-only Gitleaks/codespell steps — rejected: drift between local and CI gates is a bug by definition." ;
    onto:date "2026-11-04"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-precommit-gate .

onto:decision-cspell-vale a onto:Decision ;
    onto:name "cspell + Vale replace Codespell" ;
    onto:rationale "cspell covers project vocabulary and editor integration; Vale adds the prose-style layer (banned phrasing, heading case, repetitions) that spell-checking alone does not provide." ;
    onto:alternative "Codespell only — rejected: no project vocabulary, no grammar-style checks. Deviation from §9 documented pending upstream update." ;
    onto:date "2026-11-04"^^xsd:date ;
    onto:status "active" ;
    onto:affectedComponent onto:component-precommit-gate .

onto:decision-no-bundled-skills a onto:Decision ;
    onto:name "No preferences or pointer skill bundled in project repos" ;
    onto:rationale "Copying preferences.md into the repo would require the §27 byte-identical sync rule on every upstream update — guaranteed drift. The ontology-access pointer skill is a global asset whose only home is ryans-agentic-coding-preferences; AGENTS.md carries agent orientation for this repository." ;
    onto:alternative "Shipping the pointer skill per repo — rejected: the skill is global, not project content." ;
    onto:date "2026-11-04"^^xsd:date ;
    onto:status "active" .

## Lessons learned

onto:lesson-float-overflow-saturation a onto:LessonLearned ;
    onto:description "When proving SPARK floating-point arithmetic, saturate every intermediate product into the signal range before combining: unbounded product chains overflow interval bounds and stall the prover, while saturated single operations make each verification condition interval-trivial." ;
    onto:category "proof" ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:relatedComponent onto:component-core-linear .

onto:lesson-universal-fixed-intermediate a onto:LessonLearned ;
    onto:description "When writing generic fixed-point SPARK arithmetic, treat the universal_fixed intermediate as bounded at 2**Size * Delta real units of the instantiated type and remember it is computed before any clamp: pre-clamp operands into bands (products need the tight band, sums a wider one), compare and convert only after that, and restrict division to divisors whose reciprocal provably fits. Read the generated .smt2 (--debug-save-vcs) to learn the exact bound and rounding encoding per type size; test a suspicious verification condition standalone in cvc5/z3 first — a sat answer means the goal is genuinely refutable and the code must change, while a timeout means the prover needs the facts restructured." ;
    onto:category "proof" ;
    onto:date "2026-11-04"^^xsd:date ;
    onto:relatedComponent onto:component-core-fixed .

onto:lesson-fal-discrete-stability a onto:LessonLearned ;
    onto:description "Han's continuous-time fal gains do not transfer to coarse sample times: outside the fal width the continuation slope is delta^(alpha-1), so the effective z3 gain is roughly Ts * beta03 * delta^(alpha2-1) and must stay well inside 1. Discrete deployments raise the width or move exponents toward 1 (the test suite documents a stability-feasible cascade at Ts = 0.01); the classical triples remain defaults for fine-sample deployments." ;
    onto:category "control-design" ;
    onto:date "2026-11-04"^^xsd:date ;
    onto:relatedComponent onto:component-core-nonlinear .

onto:lesson-generic-child-formals a onto:LessonLearned ;
    onto:description "Children of a GNAT generic package must declare their own generic formals; formals are not inherited. Route shared contract vocabulary through an instantiated helper child (Limits) rather than relying on parent formals." ;
    onto:category "language" ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:relatedComponent onto:component-core-linear .

onto:lesson-golden-tests-catch-regression a onto:LessonLearned ;
    onto:description "Keep behavioral refactorings covered by unit and golden-value tests end to end: a cancellation term dropped during a proof-motivated restructuring was caught by the unit suite before commit." ;
    onto:category "testing" ;
    onto:date "2026-11-02"^^xsd:date ;
    onto:relatedComponent onto:component-tests .

onto:lesson-ontology-instance-marker a onto:LessonLearned ;
    onto:description "Keep the ontology's instance layer under an explicit comment block so updates are a bounded edit, not a rewrite of the schema scaffold." ;
    onto:category "ontology" ;
    onto:date "2026-11-04"^^xsd:date ;
    onto:relatedComponent onto:component-project-ontology .

